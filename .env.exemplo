# Copie para .env (cp .env.exemplo .env) e preencha, ou rode ./instalar.sh,
# que pergunta tudo e escreve este arquivo. Detalhes no README.

# Pasta do servidor onde os filmes e séries ficam (e onde o qBittorrent salva).
PASTA_FILMES=/srv/filmes

# Porta da app no servidor.
FILMES_PORT=8086

# Fuso horário.
TZ=America/Sao_Paulo

# ---------- Opção A: qBittorrent junto com a app (em Docker) ----------
# Descomente o bloco abaixo. A senha tem que ser a mesma configurada no
# qBittorrent (o instalar.sh cuida disso).
# COMPOSE_PROFILES=qbittorrent
# QBIT_URL=http://qbittorrent:8080
# QBIT_USER=admin
# QBIT_PASS=
# QBIT_PASTA=/filmes
# Interface web do qBittorrent no servidor, e a porta dos torrents.
# QBIT_PORT=8090
# QBIT_TORRENT_PORT=6881
# Dono dos arquivos baixados (veja com: id -u e id -g).
# PUID=1000
# PGID=1000

# ---------- Opção B: qBittorrent que você já tem ----------
# Se ele roda neste mesmo servidor, deixe host.docker.internal e só ajuste a porta.
QBIT_URL=http://host.docker.internal:8080
QBIT_USER=admin
QBIT_PASS=
# Só se o seu qBittorrent roda em Docker: a mesma pasta, como ela aparece
# dentro do contêiner dele (ex.: /downloads/filmes). Senão, deixe vazio.
QBIT_PASTA=
